package() {
  local hooks="$pkgdir"/usr/share/libalpm/hooks
  local bin="$pkgdir"/usr/bin

  install -Dm 644 archcraft-hook-bspwm-desktop.hook  	"$hooks"/archcraft-hook-bspwm-desktop.hook
  install -Dm 644 archcraft-hook-i3wm-desktop.hook  	"$hooks"/archcraft-hook-i3wm-desktop.hook
  install -Dm 644 archcraft-hook-openbox-desktop.hook  	"$hooks"/archcraft-hook-openbox-desktop.hook
  install -Dm 644 archcraft-hook-qtile-desktop.hook  	"$hooks"/archcraft-hook-qtile-desktop.hook
  install -Dm 644 archcraft-hook-xmonad-desktop.hook  	"$hooks"/archcraft-hook-xmonad-desktop.hook

  install -Dm 644 archcraft-hook-i3wm.hook  		"$hooks"/archcraft-hook-i3wm.hook
  install -Dm 644 archcraft-hook-openbox.hook  		"$hooks"/archcraft-hook-openbox.hook
  install -Dm 644 archcraft-hook-qtile.hook  		"$hooks"/archcraft-hook-qtile.hook
  install -Dm 644 archcraft-hook-thunar.hook  		"$hooks"/archcraft-hook-thunar.hook
  install -Dm 644 archcraft-hook-xfce-notifyd.hook  "$hooks"/archcraft-hook-xfce-notifyd.hook
			  
  install -Dm 755 archcraft-hooks-extra       		"$bin"/archcraft-hooks-extra
}
