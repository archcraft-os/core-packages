[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = archcraft-xmonad-premium
Target = archcraft-xmonad
Target = xmonad

[Action]
Description = Modifying Xmonad Desktop file...
When = PostTransaction
Exec = /usr/bin/sed -i -e 's|^Exec=.*|Exec=/usr/bin/archcraft-session xmonad|g' /usr/share/xsessions/xmonad.desktop
